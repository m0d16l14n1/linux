// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple MacBook Air (15-inch, M5), J815.
 *
 * J815 is the 15-inch sibling of J813 on the same T8142 die. It uses the
 * J813 board fragments and overrides what the J815 ADT shows to be
 * different:
 *
 *  - /chosen board-id 0x26 (J813: 0x24)
 *  - 15.3" 2880x1864 panel (2880x1800 below the notch), 326 x 211 mm
 *  - six SN012776 speaker amplifiers on i2c3 (0x38-0x3d: two tweeters and
 *    four force-cancelling woofers); J813 has four
 *  - ISP sensor-type 0x72 (J813: 0x71)
 *  - MTP hid-merge-personality C1FD3,3 (J813: C1FD1,4)
 *
 * The rest of the J813/J815 ADT difference is firmware selection (AOP
 * j815aop, acoustic-id 0x2b), ADMAC speaker channel counts and higher
 * CLPC package power limits.
 */
/dts-v1/;

#include "t8142.dtsi"
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "apple,j815", "apple,t8142", "apple,arm-platform";
	model = "Apple MacBook Air (15-inch, M5)";
	chassis-type = "laptop";

	aliases {
		serial0 = &dockchannel;
		serial1 = &serial0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:1500000n8";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* Filled by the loader. */
			status = "disabled";
		};
	};

	/*
	 * The J815 has no fan. One zone on the hottest SoC die reading (the 26
	 * apple,soc-die-keys below) slows the CPU clusters as the die heats,
	 * with the power allocator and the clusters' energy model.
	 *
	 * Sustainable power is an estimate to be tuned by a soak: the J815
	 * ADT's clpc pkg-sustainable-power-target is 12.5 W (0xc8000, 16.16),
	 * the J700's 5.5 W, where macOS holds the J700 CPUs at 4.1-4.3 W
	 * (about 76%, the J700 zones' 4200). The same share of 12.5 W gives
	 * the 9000 mW here. The control point is held below the 105 C the
	 * fanless J700 runs at, until a J815 soak under macOS gives its own
	 * value; the PMP and SMC still enforce the hardware limits.
	 */
	thermal-zones {
		soc-die-thermal {
			polling-delay-passive = <500>;
			polling-delay = <1000>;
			thermal-sensors = <&smc_hwmon 1000>;
			sustainable-power = <9000>;

			trips {
				soc_die_alert: trip-alert {
					temperature = <60000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc_die_control: trip-control {
					temperature = <100000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-p {
					trip = <&soc_die_control>;
					cooling-device =
						<&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu8 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu9 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map-e {
					trip = <&soc_die_control>;
					cooling-device =
						<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <3072>;
				};
			};
		};
	};
};

&cpu0 {
	#cooling-cells = <2>;
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu1 {
	#cooling-cells = <2>;
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu2 {
	#cooling-cells = <2>;
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu3 {
	#cooling-cells = <2>;
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu4 {
	#cooling-cells = <2>;
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu5 {
	#cooling-cells = <2>;
	operating-points-v2 = <&ecluster_opp>;
	performance-domains = <&cpufreq_e>;
	status = "okay";
};

&cpu6 {
	#cooling-cells = <2>;
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu7 {
	#cooling-cells = <2>;
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu8 {
	#cooling-cells = <2>;
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&cpu9 {
	#cooling-cells = <2>;
	operating-points-v2 = <&pcluster_opp>;
	performance-domains = <&cpufreq_p>;
	status = "okay";
};

&{/timer} {
	status = "okay";
};

&aic {
	status = "okay";
};

&cpu_pmu {
	status = "okay";
};

&dockchannel {
	status = "okay";
};

#include "t8142-j813-display.dtsi"
#include "t8142-j813-gpu.dtsi"
#include "t8142-j813-peripherals.dtsi"
#include "t8142-j813-j815.dtsi"
#include "t8142-j813-usb.dtsi"
#include "t8142-j813-dcpext.dtsi"
/* DisplayPort audio of the two external displays (J813: identical ADT, not tested there yet). */
#include "t8142-j813-dpaudio.dtsi"
#include "t8142-j813-avd.dtsi"
#include "t8142-j813-isp.dtsi"
#include "t8142-j813-n1.dtsi"
#include "t8142-j813-audio.dtsi"

&mtp_hid {
	multi-touch {
		/* ADT hid-merge-personality C1FD3,3 (J813: C1FD1,4). */
		firmware-name = "apple/tpmtfw-j815.bin";
	};
};

&pmp {
	/* ADT /chosen board-id (J815) */
	apple,board-id = <38>;
};

&panel {
	compatible = "apple,panel-j815", "apple,panel";
	width-mm = <326>;
	height-mm = <211>;
	adj-height-mm = <204>;
};

&isp {
	/* J815 ADT /arm-io/isp sensor-type */
	apple,platform-id = <0x72>;
};

&aop_audio {
	/* The microphone card's name: AppleJ815HPAI. */
	apple,chassis-name = "J815";
	/* ADT iop-audio-controller/audio-speaker: 6 slots, 12 sense words. */
	apple,speaker-amps = <6>;
};

/*
 * Ambient light sensor, the AOP's "als" service: an ST VD6286, as on the
 * M4 Pro, not T8140's CT817. aop_als sends it the per-device calibration
 * (apple/aop-als-cal.bin) as its calibration property. There is no
 * firmware-name: that names the CT817 setup-port message, which this sensor
 * does not take.
 */
&aop {
	aop_als: als {
		compatible = "apple,t8142-aop-als", "apple,aop-als";
	};

	/*
	 * Lid angle: the J815 AOP firmware announces a "las" service, which
	 * macOS 27.2 on this machine binds as an AppleSPUHIDDevice (usage page
	 * 0x20, usage 0x8a), as on T6050. The ADT's i2c1 "mogul-las" is the
	 * sensor's authentication chip, not the angle.
	 */
	aop_las: las {
		compatible = "apple,t8142-aop-las", "apple,aop-las";
	};

	/*
	 * The inertial sensor: ADT iop-aop-nub accel and gyro. The boot loader
	 * copies their calibration from the ADT into these nodes; without it
	 * the services stay off. devmotion6 gets a device only if the firmware
	 * announces it.
	 */
	aop_accel: accel {
		compatible = "apple,t8142-aop-accel", "apple,aop-accel";
	};

	aop_gyro: gyro {
		compatible = "apple,t8142-aop-gyro", "apple,aop-gyro";
	};

	aop_devmotion: devmotion6 {
		compatible = "apple,t8142-aop-devmotion6", "apple,aop-devmotion6";
	};
};

/* Names as in speakersafetyd's j815.conf; slots from ADT speaker-config. */
&speaker_left_woofer {
	sound-name-prefix = "Left Woofer 1";
};

&speaker_right_woofer {
	sound-name-prefix = "Right Woofer 1";
};

&i2c3 {
	speaker_left_woofer_2: codec@3a {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3a>;
		shutdown-gpios = <&pinctrl_ap 151 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 2";
		ti,imon-slot-no = <18>;
		ti,vmon-slot-no = <16>;
		ti,bclk-ratio = <250>;
	};

	speaker_right_woofer_2: codec@3d {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3d>;
		shutdown-gpios = <&pinctrl_ap 151 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 2";
		ti,imon-slot-no = <22>;
		ti,vmon-slot-no = <20>;
		ti,bclk-ratio = <250>;
	};
};

/ {
	sound {
		compatible = "apple,j815-macaudio", "apple,macaudio";
		model = "MacBook Air J815";

		dai-link@1 {
			/*
			 * ADT speaker-config order: macaudio gives codec k playback
			 * slot k (left in 0, 2, 4; right in 1, 3, 5) as macOS does.
			 * The TX idle masks are J813's: J815's amp-tx-zd-config has
			 * the same words (left amps drive slots 0-3, 8-11, 16-19 on
			 * line 0, right amps 4-7, 12-15, 20-23 on line 1).
			 */
			codec {
				sound-dai = <&speaker_left_woofer>, <&speaker_right_woofer>,
					    <&speaker_left_tweeter>, <&speaker_right_tweeter>,
					    <&speaker_left_woofer_2>, <&speaker_right_woofer_2>;
			};
		};
	};
};

/*
 * N1 functions behind apcie port 0 (0000:00:00.0 -> 01:00.{0,1,2}), so the
 * loader has somewhere to put the factory addresses: it copies ADT /chosen
 * mac-address-wifi0 and mac-address-bluetooth0 into the wifi0/bluetooth0
 * alias targets, as on T6050 (t6050-j716s.dts).
 */
/ {
	aliases {
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
		/*
		 * The loader finds the SEP through this alias: it reserves SEPFW
		 * and copies the boot's local-policy and iBoot manifests onto
		 * the node.
		 */
		sep = &sep;
	};
};

&pcie0 {
	n1_port: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		bus-range = <1 1>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		n1_control: control@0,0 {
			compatible = "apple,t8142-centauri-control", "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			/* Filled by the loader */
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			/* Filled by the loader */
			local-bd-address = [00 00 00 00 00 00];
		};
	};
};

/*
 * SMC sensors beyond the discovered temperatures. Only non-temperature nodes
 * may be added here: a temperature-* node would stop
 * apple,discover-temperatures. Keys the SMC lacks are skipped at probe. The
 * die key list is J704's (same T8142): the listed keys form the SoC die
 * thermal zone.
 */
&smc {
	smc_hwmon: hwmon {
		/* Sensor 1000 is the hottest of the die keys (soc-die-thermal). */
		#thermal-sensor-cells = <1>;
		apple,soc-die-keys = "Te04", "Te08", "Te0C", "Te0R",
				     "Tp00", "Tp04", "Tp0C", "Tp0G", "Tp0O",
				     "Tp0R", "Tp0X", "Tp0a", "Tp0p", "Tp0u",
				     "Tp0y", "Tp12", "Tp16", "Tp1E",
				     "Tg0U", "Tg0X", "Tg0d", "Tg0g", "Tg0j",
				     "Tg1Y", "Tg1c", "Tg1g";
		apple,thermal-pressure-key = "mTPL";

		power-PSTR {
			apple,key-id = "PSTR";
			label = "Total System Power";
		};

		power-PDTR {
			apple,key-id = "PDTR";
			label = "AC Input Power";
		};

		power-PMVR {
			apple,key-id = "PMVR";
			label = "3.8 V Rail Power";
		};

		voltage-VD0R {
			apple,key-id = "VD0R";
			label = "AC Input Voltage";
		};

		voltage-SBAV {
			apple,key-id = "SBAV";
			label = "Battery Voltage";
		};

		current-ID0R {
			apple,key-id = "ID0R";
			label = "AC Input Current";
		};
	};
};

/*
 * Secure Enclave and the Touch ID sensor. All values are from the J815 ADT
 * (macOS 27.0):
 *  - sep: iop-sep,ascwrap-v6 at 0x30a600000 (0x88000), pre-booted by iBoot
 *    (sepfw-booted), so apple_sep warm-attaches; its mailbox is the ASC
 *    mailbox at +0x8000, AIC 445-448 (ADT order 446,445,448,447 as on the
 *    AOP: send-empty..recv-not-empty ascending).
 *  - dart-sep: t8110 at 0x308b80000, irq 455; input aperture vm-base-0
 *    0x10000004000 + vm-size-0 0xffff0000 (the BIT(40) alias, as T8132).
 *  - spi2 at 0x3a5108000, irq 0x4d9; PMGR device SPI2 at +0x440, parent
 *    SPI_P (id 94).
 *  - mesa: "biosensor,mesa", sensor-id V3, 8 MHz, CS0; power
 *    function-mesa_pwr = NUB GPIO pin 36; data-ready interrupt on AP
 *    GPIO pin 200.
 * The SEP and its DART stay disabled here: apple_sep enables them at module
 * init (drivers/soc/apple/dt.rs).
 */
&pmgr {
	ps_spi2: power-controller@440 {
		compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x440 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		power-domains = <&ps_spi_p>;
		label = "spi2";
	};
};

&{/soc} {
	sep: sep@30a600000 {
		compatible = "apple,sep";
		reg = <0x3 0x0a600000 0x0 0x88000>;
		mboxes = <&sep_mbox>;
		mbox-names = "mbox";
		iommus = <&sep_dart 0>;
		status = "disabled";
	};

	sep_mbox: mbox@30a608000 {
		compatible = "apple,t8142-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x3 0x0a608000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 445 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 446 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 447 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 448 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
				  "recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
		status = "okay";
	};

	spi2: spi@3a5108000 {
		compatible = "apple,t8142-spi", "apple,t8103-spi";
		reg = <0x3 0xa5108000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1241 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkref>;
		power-domains = <&ps_spi2>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		mesa: fingerprint@0 {
			compatible = "apple,mesa-fingerprint";
			reg = <0>;
			spi-max-frequency = <8000000>;
			spi-cpol;
			spi-cs-setup-delay-ns = <20>;
			spi-cs-hold-delay-ns = <20>;
			enable-gpios = <&pinctrl_nub 36 GPIO_ACTIVE_HIGH>;
			interrupt-parent = <&pinctrl_ap>;
			interrupts = <200 IRQ_TYPE_EDGE_RISING>;
			/* Per-device files, built from the Mac's own factory records. */
			firmware-name = "apple/mesacal-j815.bin", "apple/msrk-j815.bin";
			status = "okay";
		};
	};
};

&sep_dart {
	apple,dma-range = /bits/ 64 <0x10000004000 0xffff0000>;
	apple,dma-offset = /bits/ 64 <0x0>;
};

/* Expose the sensor's two pins next to the ones sound uses. */
&pinctrl_ap {
	gpio-reserved-ranges = <0 100>, <101 49>, <152 48>, <201 23>;
};

&pinctrl_nub {
	gpio-reserved-ranges = <0 18>, <19 17>, <37 3>;
};

/* aura (mcc_init_m5) turns the system level cache on; the driver confirms it and flushes on shutdown. */
&mcc {
	status = "okay";
};

/*
 * Video encoder: ADT ave behind dart-ave (DART + CPUDART). aura hands over the
 * preloaded 26A428 firmware (memory regions, CRCs in /chosen) or disables the
 * node when the ADT has no preload.
 */
&ps_venc_sys {
	status = "okay";
};

&ps_venc_dma {
	status = "okay";
};

&ps_venc_pipe4 {
	status = "okay";
};

&ps_venc_pipe5 {
	status = "okay";
};

&ps_venc_me0 {
	status = "okay";
};

&ps_venc_me1 {
	status = "okay";
};

&ave_dart0 {
	status = "okay";
};

&ave_dart1 {
	status = "okay";
};

&ave {
	status = "okay";
};

/*
 * The Neural Engine. It stays off until the first request: the firmware is
 * started then, from the preload, and system sleep cycles it cold.
 */
&ps_ane_sys {
	status = "okay";
};

&ane_dart0 {
	status = "okay";
};

&ane_dart1 {
	status = "okay";
};

&ane_dart2 {
	status = "okay";
};

&ane {
	status = "okay";
};

/* Both JPEG engines and their DART. */
&ps_jpg {
	status = "okay";
};

&jpeg_dart {
	status = "okay";
};

&jpeg0 {
	status = "okay";
};

&jpeg1 {
	status = "okay";
};

/* The ProRes encoder; it probes only with the Mac's own apple/prores-t8142-init.bin. */
&ps_scodec {
	status = "okay";
};

&apr_dart {
	status = "okay";
};

&apr {
	status = "okay";
};

/*
 * SIO AES engine, software keys only. It registers below the CPU's aes-ce, so
 * it is used only when asked for by driver name.
 */
&ps_sio {
	status = "okay";
};

&ps_aes {
	status = "okay";
};

&sio_dart {
	status = "okay";
};

&aes {
	status = "okay";
};

/*
 * The MagSafe 3 port's PD controller: ADT hpm5 on nub-spmi-a0, SID 8, port-type
 * 0x11. It has no USB data path, so it gets no connector node; tipd registers a
 * Type-C port and a power supply for it, as on J714s. The bus is polled on
 * T8142, so like hpm0 and hpm1 it has no interrupts. Its ADT features-supported
 * is <3>, "Power In" only: no liquid detection.
 */
&nub_spmi_a0 {
	hpm5: usb-pd@8 {
		compatible = "apple,sn201202x";
		reg = <0x8 SPMI_USID>;
		apple,no-liquid-detection;
	};
};

/*
 * The DCP DART's PS write-disable bit, which T8142 has instead of T8140's GAPF slice. Live ADT
 * dart-dcp: clock-protection-wr-dis-id <0x1f 0xff>, PSWR instance 0 = reg[1] 0x380714000.
 * /chosen/dart-ps-wr-dis-entries[0x1f] = {offset 0x3fdc, instance 0, bit 6, refcount 1}, and
 * the T8142 SPTM (27.2.1) sets that bit on the 0->1 refcount and clears it on 1->0 at the
 * DART's power-down, where T8140's clears GAPF bit 4. Set, the fabric rejects writes to
 * DISP_CPU's power word: the DART driver clears it once the DCP is stopped and sets it again
 * after. Only a DCP firmware stop uses it. Never run on an M5.
 */
&dcp_dart {
	reg = <0x2 0x86340000 0x0 0x20000>,
	      <0x3 0x80717fdc 0x0 0x4>;
	reg-names = "dart", "ps-wr-dis";
	apple,ps-wr-dis-bit = <6>;
};

/*
 * Suspend-to-RAM (apple,t8142-sleep): derived from macOS 27.2.1 and T8132's measurements, and
 * dry-run gated in the driver (apple_sleep.deep, apple_sleep.untested_commit).
 */
&pmgr {
	/*
	 * SEP (J815 ADT, PMGR +0xc00). Never switched by Linux: named so the enclave's sleep
	 * request (pm_shim) and the deep sleep's last refusal can read its state, as on J713.
	 */
	ps_sep: power-controller@c00 {
		compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0xc00 4>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		label = "sep";
		apple,always-on;
		apple,firmware-owned;
	};
};

/* For the enclave's sleep request; the domain is firmware-owned. */
&sep {
	power-domains = <&ps_sep>;
};

&{/soc} {
	/*
	 * The CPU cores' power-gate enables, /arm-io/pmgr reg[34] (0x380724000): one word per
	 * core at a 0x10 stride, E cores 0..5 at +0x0..+0x50, P cores at +0x60... iBoot leaves
	 * the boot core's (P core 0, +0x60) clear (probe snapshot: 0), so the boot core never
	 * powers off in WFI, the P complex stays BUSY at the commit and WD2 resets (b44-b46).
	 * AppleT8142PMGR's restoreHW sets exactly +0x0 and +0x60, T8132 (J713) enables the
	 * same two words at boot, T6050 measured the same failure with core 0's word clear.
	 */
	cluster_pwrgate: power-gate@380724000 {
		compatible = "apple,t8142-cluster-pwrgate", "apple,cluster-pwrgate";
		reg = <0x3 0x80724000 0x0 0x4>,
		      <0x3 0x80724060 0x0 0x4>;
	};

	/*
	 * Suspend-to-RAM. The blocks are T8132's, at the same J815 ADT indices: /arm-io/pmgr
	 * reg[32] (ps), [34] (pwrgate), [42] (cpu-start), [45] (cllt; EARLY_WAKEUP_CFG at
	 * +0x50), [36] (cluster), [40] + 0x4000 (commit), [38] (aon-misc), [4] (wake: nine mask
	 * and nine status words), [1] (ps-aon), /arm-io/wdt, nub-spmi0, nub-spmi-a0, the
	 * PMC's voter floors (as &pmc), and the SoC and DCS perf-state words that
	 * AppleT8142PMGR::setPerfState writes (reg[2] + 0x24000, + 0x25000).
	 * Derived from macOS 27.2.1 and T8132's measurements, never run on an M5: the driver
	 * stops each sleep at a dry run unless booted with apple_sleep.untested_commit=1,
	 * and deep sleep is only used when asked for (mem_sleep).
	 */
	sleep: sleep-controller@380700000 {
		compatible = "apple,t8142-sleep";
		reg = <0x3 0x80700000 0x0 0x18000>,
		      <0x3 0x80724000 0x0 0x2000>,
		      <0x3 0x80734000 0x0 0x10>,
		      <0x3 0x80768000 0x0 0x54>,
		      <0x3 0x80780000 0x0 0x8>,
		      <0x3 0x882d4000 0x0 0x4>,
		      <0x3 0x882b0000 0x0 0x30>,
		      <0x3 0x882b8000 0x0 0x44>,
		      <0x3 0x88004000 0x0 0x50>,
		      /* SPMI gen 4: queue at +0x200..0x220, notify enable/ack +0x420/+0x620 */
		      <0x3 0x88714000 0x0 0x1000>,
		      <0x3 0x88280000 0x0 0x10000>,
		      /* nub-spmi-a0's notify enable word (gen 4: +0x420; gen 1 had +0x40) */
		      <0x3 0x88908420 0x0 0x4>,
		      <0x3 0x82700000 0x0 0x10000>,
		      <0x3 0x80024000 0x0 0x4>,
		      <0x3 0x80025000 0x0 0x4>,
		      /*
		       * Each complex's ACC word 0x40f8 (ADT pmgr reg[7] E, reg[18] P, + 0x40f8),
		       * which AppleT8142PMGR sets to 1 after the complex powers on and at the
		       * end of restoreHW.
		       */
		      <0x2 0x10e440f8 0x0 0x4>,
		      <0x2 0x11e440f8 0x0 0x4>;
		reg-names = "ps", "pwrgate", "cpu-start", "cllt", "cluster",
			    "commit", "wdt", "aon-misc", "wake", "spmi",
			    "ps-aon", "spmi-a0", "pmc-voters", "clk-perf", "dcs",
			    "acc-e", "acc-p";
		/*
		 * From the J815 ADT's /arm-io/pmgr ap-wake-sources, the same sources
		 * as T8132's by name: NUB.SPMI0.SW3, ATC0.USBWakeup, SMC.CPUWakeupAP,
		 * SMC.OutboxNotEmpty, MTP.DOCK.CHANNELS.AP0.IRQ and MTP.OutboxNotEmpty.
		 */
		apple,wake-enable = <152 72 168 190 89 108>;
		apple,display-coprocessors = <&dcp>;
		/* ANS's link's shared block, and the radio's link, which only aura trains */
		apple,apcie = <&apcie_shared>;
		apple,radio-host = <&pcie0>;
		/* ADT pci-bridge0 function-perst: AP GPIO 192 */
		apple,radio-perst = <&pinctrl_ap 192 GPIO_ACTIVE_LOW>;
		apple,pinctrl = <&pinctrl_ap>;
		/* The ADT's no-restore-gpio-pins: reading pin 78 raises an SError. */
		apple,pinctrl-skip-pins = <78 203>;
	};

	/*
	 * The internal display's power words for a DCP firmware stop (drm/apple dcp_s2r_*),
	 * written only with appledrm.s2r_untested=1: /arm-io/pmgr reg[34] (pwrgate: DISP_CPU's
	 * retention words 0x11cc and 0x11f0, the pmgr's retention_config_ff/_mem) and reg[32]
	 * (ps: DISP_CPU 0x10000, DISP_FE 0x318, DISP_SYS 0x290). T8142's PMC has no count of
	 * powered DCPs, so no pmc-dcp. Derived from macOS 27.2.1, never run.
	 */
	/*
	 * ANS's side of the shared PCIe block, which the sleep controller brings back after a
	 * real sleep in AppleT8142PCIe's order (as aura's j813_n1.c at boot): ADT /arm-io/apcie
	 * reg[1] (rc), [2] (phy-block; its PHY-PHY control words are reg[3], 0x20000 in), [4]
	 * (phy-ip) and [5] (axi2af, as far as its tables reach). Then the radio's port 0, which
	 * it trains again after the wake: reg[8] (radio-port), [10] (radio-lane) and the root
	 * port's configuration space (radio-cfg, the ECAM's first 4 KiB). reg[6] (clkgen, the
	 * pcieclkgen whose PLLs APCIECoreRCGen4 shuts down before the power goes; AppleT8142PCIe
	 * maps reg[7] as its AUS5 AON top, unused here). aura copies the ADT's
	 * apcie-{axi2af,phy,phy-ip-pll,phy-ip-auspma}-tunables and pci-bridge0's
	 * apcie-config-tunables and pcie-rc{,-gen3-shadow,-gen4-shadow}-tunables here. No
	 * driver binds it.
	 */
	apcie_shared: pcie-shared@48c000000 {
		reg = <0x4 0x8c000000 0x0 0x4000>,
		      <0x4 0x8f000000 0x0 0x40000>,
		      <0x4 0x8f040000 0x0 0x20000>,
		      <0x4 0x8e000000 0x0 0x24000>,
		      <0x4 0x88028000 0x0 0x8000>,
		      <0x4 0x8f010000 0x0 0x4000>,
		      <0x1c 0xb0000000 0x0 0x1000>,
		      <0x4 0x8d044000 0x0 0x4000>;
		reg-names = "rc", "phy-block", "phy-ip", "axi2af",
			    "radio-port", "radio-lane", "radio-cfg", "clkgen";
	};

	dcp_power: display-power@380724000 {
		compatible = "apple,t8142-display-power";
		reg = <0x3 0x80724000 0x0 0x2000>,
		      <0x3 0x80700000 0x0 0x14000>;
		reg-names = "pwrgate", "ps";
	};
};

&dcp {
	apple,display-power = <&dcp_power>;
};
